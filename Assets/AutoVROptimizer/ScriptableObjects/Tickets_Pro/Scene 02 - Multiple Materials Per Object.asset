  m_Script: {fileID: 11500000, guid: 40f851f310b170d46a2387d5cc9d7008, type: 3}
  m_Name: Scene 02 - Multiple Materials Per Object
  m_EditorClassIdentifier: 
  data:
    name: Avoid Having Multiple Materials on the Same Object.
    description: "<b>\u2022 What It Does:</b> Having more than one material per mesh
      increases draw calls.\n\n<b>\u2022 Our Modification: </b>Limiting objects to
      one material keeps rendering fast and avoids batching issues."
    state: 0
    level: 1
    tags: 16960
    functionName: MultipleMaterials
    noFix: 1
    noRestore: 0
    hide: 0
